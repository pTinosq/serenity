# Copy to .env and fill in. Settings are loaded via pydantic-settings.

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# OpenRouter (required) — used for all LLM calls
OPENROUTER_API_KEY=sk-or-...
# OpenRouter model id (provider/model). See https://openrouter.ai/models
SENTIMENT_MODEL=openai/gpt-5.4-nano

# Twitter (required) — full URL of the X account whose tweets we track
TRACKED_X_ACCOUNT=https://x.com/example
# X (required) — App Bearer Token from your developer project.
# Get one at https://developer.x.com/en/portal/dashboard
# Filtered stream is pay-per-use ($0.005/post, capped at 2M/month).
X_BEARER_TOKEN=...

# Trading
# Orders below this confidence (0.0 – 1.0) are skipped.
MIN_CONFIDENCE=0.7
# Per-trade notional is `sentiment * MAX_TRADE_USD`, clamped to [MIN, MAX]
# and to available cash. Sub-MIN trades (or insufficient cash) are skipped.
MIN_TRADE_USD=10.0
MAX_TRADE_USD=100.0

# Alpaca (optional) — paper or live trading API credentials.
# Without these, the Twitter→Oracle pipeline still runs and trades are skipped.
# Get keys from https://app.alpaca.markets/ (paper) or https://app.alpaca.markets/brokerage/dashboard (live).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# True = paper trading (default, safe). False = real money.
ALPACA_PAPER=True

# Alerts — which channel surfaces alerts the bot couldn't act on
# (e.g. non-tradeable tickers). One of: stdout, telegram.
ALERT_FALLBACK_CHANNEL=stdout

# How often to deliver alerts.
#   per-tweet — fire a message after every event (default; can be noisy
#               if the tracked account tweets often).
#   daily     — buffer events and deliver one summary per day at
#               DAILY_MESSAGE_DELIVERY_UTC.
MESSAGE_FREQUENCY=per-tweet
# Time of day (HH:MM, 24h, UTC) when the daily summary is delivered.
# Only used when MESSAGE_FREQUENCY=daily.
DAILY_MESSAGE_DELIVERY_UTC=21:30

# Telegram (required if ALERT_FALLBACK_CHANNEL=telegram).
# Setup:
#   1. Create a bot via @BotFather on Telegram, paste the token below.
#   2. DM your new bot any message so it can see you.
#   3. Open https://api.telegram.org/bot<TOKEN>/getUpdates and copy
#      the chat.id value into TELEGRAM_CHAT_ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
