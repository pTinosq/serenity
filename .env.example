# Copy to .env and fill in. Settings are loaded via pydantic-settings.

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# OpenRouter (required) — used for all LLM calls
OPENROUTER_API_KEY=sk-or-...
# OpenRouter model id (provider/model). See https://openrouter.ai/models
SENTIMENT_MODEL=openai/gpt-5.4-nano

# Twitter (required) — full URL of the X account whose tweets we track
TRACKED_X_ACCOUNT=https://x.com/example

# Trading
# Orders below this confidence (0.0 – 1.0) are skipped.
MIN_CONFIDENCE=0.7
# Hard cap on per-order notional in USD.
MAX_ORDER_AMOUNT_USD=100.0
